# Copy to .env and fill in. .env is git-ignored; docker compose reads it automatically.
# A variable exported in the shell that runs `docker compose` takes precedence over this file.

# Used by the agent for briefs and routing. Leave empty to run the agent in deterministic fallback mode.
ANTHROPIC_API_KEY=
# Model the agent calls.
ANTHROPIC_MODEL=claude-opus-5-5
